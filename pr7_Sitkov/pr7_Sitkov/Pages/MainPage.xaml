<Page x:Class="pr7_Sitkov.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr7_Sitkov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="REST-API" Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            FontFamily="GOST type B"
            FontSize="50"/>
        <Border Grid.RowSpan="4" Grid.ColumnSpan="2"
         Grid.Row="1"
         Margin="25" BorderThickness="2"
         BorderBrush="Gray" CornerRadius="10">
            <ListBox>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray"
                                BorderThickness="1" Margin="5"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="title"/>
                                    <TextBlock Text="trainer"/>
                                    <TextBlock Text="durationMinutes"/>
                                    <TextBlock Text="price"/>
                                    <TextBlock Text="isActive"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding title}"/>
                                    <TextBlock Text="{Binding trainer}"/>
                                    <TextBlock Text="{Binding durationMinutes}"/>
                                    <TextBlock Text="{Binding price}"/>
                                    <TextBlock Text="{Binding isActive}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <TextBlock Text="Список предоставленный API"
            Grid.Row="1" Grid.RowSpan="3"
            FontFamily="GOST type B"
            Padding="5">
            <TextBlock.LayoutTransform>
                <RotateTransform Angle="270"/>
            </TextBlock.LayoutTransform>
        </TextBlock>
        <Border Grid.Column="2" Grid.RowSpan="2"
         Margin="20" CornerRadius="10"
         BorderThickness="2" BorderBrush="Gray"/>
        <Border Grid.Row="2" Grid.Column="2"
         Margin="25" CornerRadius="10" 
         Background="LightGray"
         BorderBrush="LightGreen"
         BorderThickness="3">
            <Button Content="Добавить запись" Click="AddObj"
         Grid.Row="2" Grid.Column="2"
         BorderBrush="Transparent"
         Background="Transparent"
         FontFamily="GOST Type BU"
         FontSize="20" Foreground="Gray"/>
        </Border>
        <Border Grid.Row="3" Grid.Column="2"
     Margin="25" CornerRadius="10" 
     Background="LightGray"
     BorderBrush="LightCoral"
     BorderThickness="3">
            <Button Content="Изменить запись" Click="ChangeObj"
     Grid.Row="3" Grid.Column="2"
     BorderBrush="Transparent"
     Background="Transparent"
     FontFamily="GOST Type BU"
     FontSize="20" Foreground="Gray"/>
        </Border>
        <Border Grid.Row="4" Grid.Column="2"
     Margin="25" CornerRadius="10" 
     Background="LightGray"
     BorderBrush="red"
     BorderThickness="3">
            <Button Content="Удалить запись"
     Grid.Row="4" Grid.Column="2"
     BorderBrush="Transparent"
     Background="Transparent"
     FontFamily="GOST Type BU"
     FontSize="20" Foreground="Gray"/>
        </Border>
    </Grid>
</Page>
