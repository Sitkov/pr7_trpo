<Page x:Class="pr7_Sitkov.Pages.NewObject"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr7_Sitkov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewObject">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Добaвление нового объекта"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="32" FontWeight="Bold"
                   FontFamily="GOST type B"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <TextBlock Text="title:" Width="125"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="16" FontWeight="Bold"
                   FontFamily="GOST type B"/>
            <TextBox Height="20" Width="200" Margin="20"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <TextBlock Text="trainer:" Width="125"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="16" FontWeight="Bold"
                   FontFamily="GOST type B"/>
            <TextBox Height="20" Width="200" Margin="20"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <TextBlock Text="durationMinutes:" Width="125"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="16" FontWeight="Bold"
                   FontFamily="GOST type B"/>
            <TextBox Height="20" Width="200" Margin="20"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <TextBlock Text="price:" Width="125"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="16" FontWeight="Bold"
                   FontFamily="GOST type B"/>
            <TextBox Height="20" Width="200" Margin="20"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <TextBlock Text="isActive:" Width="125"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="16" FontWeight="Bold"
                   FontFamily="GOST type B"/>
            <TextBox Height="20" Width="200" Margin="20" />
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Border Grid.Row="2" Grid.Column="2"
                    Margin="15" CornerRadius="10" 
                    Background="LightGray"
                    BorderBrush="Gray"
                    BorderThickness="3">
                <Button Content="Назад" Click="BackGo"
                          Grid.Row="2" Grid.Column="2"
                          BorderBrush="Transparent"
                          Background="Transparent"
                          FontFamily="GOST Type BU"
                          FontSize="16" Foreground="Gray"
                        />
            </Border>
            <Border Grid.Row="2" Grid.Column="2"
                      Margin="15" CornerRadius="10" 
                      Background="LightGray"
                      BorderBrush="LightGreen"
                      BorderThickness="3">
                <Button Content="Добавить"
                          Grid.Row="2" Grid.Column="2"
                          BorderBrush="Transparent"
                          Background="Transparent"
                          FontFamily="GOST Type BU"
                          FontSize="16" Foreground="Gray"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
